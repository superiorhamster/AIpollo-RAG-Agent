# Local development placeholders. Override host ports here if they are in use.
WEB_PORT=23000
API_GATEWAY_PORT=23001
# WEB_ORIGIN defaults to http://127.0.0.1:${WEB_PORT}. Set it for a different hostname or scheme.
# make env generates AUTH_DB_PASSWORD, AUTH_MIGRATION_PASSWORD, WORKSPACE_DB_PASSWORD,
# WORKSPACE_MIGRATION_PASSWORD, AUTH_WORKSPACE_TOKEN, and AUTH_JWT_SIGNING_KEY in the local .env file.
# Phase 02 database, service, and broker credentials are generated by make env.
# DOCUMENT_BUCKET defaults to rag-documents.

POSTGRES_DB=super_agentic_rag
POSTGRES_USER=super_rag
POSTGRES_PASSWORD=
POSTGRES_PORT=23002

REDIS_PORT=23003

RABBITMQ_DEFAULT_USER=super_rag
RABBITMQ_DEFAULT_PASS=
