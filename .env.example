# Local development placeholders. Override host ports here if they are in use.
WEB_PORT=23000
API_GATEWAY_PORT=23001
# WEB_ORIGIN defaults to http://127.0.0.1:${WEB_PORT}. Set it for a different hostname or scheme.
# make env generates AUTH_DB_PASSWORD, AUTH_MIGRATION_PASSWORD, WORKSPACE_DB_PASSWORD,
# WORKSPACE_MIGRATION_PASSWORD, AUTH_WORKSPACE_TOKEN, and AUTH_JWT_SIGNING_KEY in the local .env file.
# Phase 02 database, service, and broker credentials are generated by make env.
# DOCUMENT_BUCKET defaults to rag-documents.

POSTGRES_DB=super_agentic_rag
POSTGRES_USER=super_rag
POSTGRES_PASSWORD=super_rag_local_only
POSTGRES_PORT=23002

REDIS_PORT=23003

RABBITMQ_DEFAULT_USER=super_rag
RABBITMQ_DEFAULT_PASS=super_rag_local_only
RABBITMQ_AMQP_PORT=23004
RABBITMQ_MANAGEMENT_PORT=23005

QDRANT_HTTP_PORT=23006
QDRANT_GRPC_PORT=23007

MINIO_ROOT_USER=super_rag
MINIO_ROOT_PASSWORD=super_rag_local_only_change_me
MINIO_API_PORT=23008
MINIO_CONSOLE_PORT=23009

# Embedding support is disabled until a compatible provider has been configured.
MODEL_PROVIDER=disabled
# Enable only for an OpenAI-compatible service on this development machine.
MODEL_ALLOW_LOCAL_HTTP=false
MODEL_EMBEDDING_BASE_URL=
MODEL_EMBEDDING_NAME=
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_DIMENSIONS=
MODEL_EMBEDDING_REVISION=1
MODEL_EMBEDDING_PROTOCOL=openai
# Absolute existing cache path, used only with compose.ollama.yaml. Never commit weights.
OLLAMA_MODELS_DIR=
MODEL_CHAT_BASE_URL=
MODEL_CHAT_NAME=
MODEL_CHAT_API_KEY=

CROSSREF_MAILTO=

SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Runtime deadlines: caller deadlines and leases are derived from these values.
DOCUMENT_PARSE_TIMEOUT_SECONDS=300
MODEL_EMBEDDING_TIMEOUT_SECONDS=60
INDEX_JOB_TIMEOUT_SECONDS=1800
RUN_TIMEOUT_SECONDS=210

# Optional: defaults to 16 in base Compose, 1 in the local Ollama overlay.
INGESTION_EMBED_BATCH_SIZE=

# Opt-in academic workflows.
AGENTIC_WORKFLOW_ENABLED=false
AGENTIC_TUTOR_ENABLED=false

# Experimental Ask citations: legacy, auto, single or two.
INDEX_SENTENCE_CITATIONS=false
ASK_SENTENCE_CITATIONS=legacy
